# ==============================================================================
# 💡【使用說明】
# 下載此專案後，請將此檔案複製一份並改名為 `.env`
# 並將新的 `.env` 檔案放置於內層的 `/cocktail_query_drf/` 資料夾中！
# ==============================================================================

# ==============================================================================
# Django & 開發環境基礎設定
# ==============================================================================
DJANGO_SECRET_KEY=django-insecure-your-secret-key-here-please-change-in-production
DEBUG=True
DEVELOPMENT_MODE=True

# 允許的主機網域（多個請用逗號隔開；本機開發若留空且 DEBUG=True 則預設允許所有）
# ALLOWED_HOSTS=127.0.0.1,localhost,your-backend-app.onrender.com

# 跨域請求白名單（多個請用逗號隔開；若留空則預設允許所有來源）
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.netlify.app

# 雲端部署專用連線字串（本地端若不用可保持空白）
DATABASE_URL=

# ==============================================================================
# 資料庫設定：PostgreSQL (本地實體與 Docker 同步標準架構)
# ==============================================================================
PostgreSQL_NAME=cocktail_db
PostgreSQL_USER=cocktail_user
PostgreSQL_PASSWORD=
PostgreSQL_HOST=127.0.0.1
PostgreSQL_PORT=5432
